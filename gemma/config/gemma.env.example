# Copy to ~/.config/gemma.env on the Mac (install-gemma-stack.sh does this on first run).
# Never commit the filled-in file. Read by every script in gemma/bin and by the model-server daemon.
# After editing: RESTART=1 ~/bin/gemma-up.sh
# Engine: llamacpp (llama.cpp llama-server, GGUF) or mlx (mlx-vlm, MLX). To switch, run the
# installer with ENGINE=... once so the other engine and its model get installed.
ENGINE=llamacpp
GGUF_REPO=lmstudio-community/gemma-4-26B-A4B-it-QAT-GGUF
GGUF_QUANT=Q4_0
MLX_REPO=mlx-community/gemma-4-26B-A4B-it-qat-4bit
# Context: 32768 (fits 32 GB: 18.2 GB peak wired, measured on an M1 Max). The cache is shared by the NP requests.
CTX=32768
# Simultaneous requests. llama.cpp shares CTX across them; mlx gives each up to CTX.
NP=2
PORT=1234
# Optional Hugging Face read token for faster, higher-limit model downloads (installer only;
# the model server runs offline). Create at huggingface.co → Settings → Access Tokens (Read).
# Keep this file private: chmod 600 ~/.config/gemma.env
# HF_TOKEN=
OWUI_PORT=8080
