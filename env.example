# Copy to ~/.config/macllm.env (never commit the real file)
OWUI_EMAIL=you@example.com
# URL m5-health.sh probes for Open WebUI through Caddy; use the host name or LAN address in the Caddy certificate
OWUI_PROBE_URL=https://your-host.local:8443/
# Origins browsers use for Open WebUI (space separated, each with its :8443 suffix); m5-health.sh handshakes each one
OWUI_ORIGINS="https://your-host.local:8443 https://192.0.2.10:8443"
# 1 = macOS notification when m5-health-watch.sh finds a problem (default 0: log only)
HEALTH_NOTIFY=0
# m5-drift.sh (run by the watcher): defaults shown; set only to override
# CADDY_ROOT=/opt/homebrew/var/lib/caddy/pki/authorities/local/root.crt
# DRIFT_PLIST_DIRS="/Library/LaunchDaemons /Library/LaunchAgents $HOME/Library/LaunchAgents"

# OWUI_ERR_LOG=/usr/local/var/open-webui/serve.stderr.log
# OWUI_PLIST=/Library/LaunchDaemons/com.openwebui.serve.plist
