# env.example — copy to ~/.config/macmonitor.env and fill in your values.
# ~/.config/ is in .gitignore; never commit the real file.
#
# Source this in your shell or reference it from the LaunchDaemon plist.
# Usage from zsh/bash:  set -a; source ~/.config/macmonitor.env; set +a

# Full path to the background image shown behind the desktop widget.
MONITOR_BG_IMAGE=~/.../.local/bin/TxtSysMonBkgd.webp

# Paths for persistent history and state (survive restarts).
MONITOR_HISTORY_FILE=~/.../.local/bin/mem_history.json
MONITOR_STATE_FILE=~/.../.local/bin/monitor_state.json

# ── MBP collector (mbp_monitor.py, M-ProcessorSystemMonitor) ─────────────
# MONITOR_PEAKS_FILE=~/.local/share/mbpmonitor_peaks.json
MONITOR_BG_IMAGE=~/.local/bin/TxtSysMonBkgd.webp
MONITOR_HISTORY_FILE=~/.local/bin/mem_history.json
MONITOR_STATE_FILE=~/.local/bin/monitor_state.json
# Optional: mlx-serve base URLs for the g4 and fls rows (defaults shown).
# MONITOR_G4_URL=http://127.0.0.1:11235
# MONITOR_FLS_URL=http://127.0.0.1:11234
