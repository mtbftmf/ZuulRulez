# env.example — copy to ~/.config/macmonitor.env and fill in your values.
# ~/.config/ is in .gitignore; never commit the real file.
#
# Source this in your shell or reference it from the LaunchDaemon plist.
# Usage from zsh/bash:  set -a; source ~/.config/macmonitor.env; set +a

# Full path to the background image shown behind the desktop widget.
MONITOR_BG_IMAGE=/Users/YOUR_USERNAME/.local/bin/TxtSysMonBkgd.webp

# Paths for persistent history and state (survive restarts).
MONITOR_HISTORY_FILE=/Users/YOUR_USERNAME/.local/bin/mem_history.json
MONITOR_STATE_FILE=/Users/YOUR_USERNAME/.local/bin/monitor_state.json
