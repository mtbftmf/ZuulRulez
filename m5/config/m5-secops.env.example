# Copy to ~/.config/m5-secops.env, chmod 600, never commit the real file.
# Distinct from ~/.config/macllm.env, which the root env.example documents.
# Read at run time by m5-secops.sh, caddy-pki-attest.sh and canary-extras.sh.
# The root audit is deliberately different: m5-secops.sh install substitutes the
# resolved clone path into its rendered copy, which reads no config file, so the
# daemon depends on nothing user-writable and install aborts if the token would
# survive into it. m5-ship.sh writes the two keys below on a fresh reconstruction.

# Label of the volume CCC clones this Mac's Data volume to.
M5_CLONE_VOL="/Volumes/clone-label"

# 7/8 of RAM in MiB. On a 128 GB machine that is 114688. Compute it with:
#   python3 -c "import os; print(os.sysconf('SC_PAGE_SIZE')*os.sysconf('SC_PHYS_PAGES')//1048576*7//8)"
# m5/launchd/system/m5-operations substitutes it into the boot daemon template, and
# iogpu.wired_limit_mb reads 0 after every boot until that daemon runs, so a missing
# key renders an empty value rather than failing loudly.
WIRED_LIMIT_MB=114688

# M5_CCC_TASK_UUID is obsolete. The exclusion verdict enumerates every task whose
# sourceDisk.apfsVolumeGroupUUID is this Data volume instead of pinning one task, so
# a task UUID here would imply a per-task trust the code no longer exercises.
