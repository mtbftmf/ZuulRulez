# M5 Max 128 GB Auto Router valve defaults (template only).
# Copy to ~/.config/zullerulz/auto_router.env on THIS machine and source it;
# do not commit the real override file. These map 1:1 to Auto Router v1.4.1 Valves.
LMSTUDIO_URL=http://localhost:1234/v1
STRONG_URL=http://127.0.0.1:11234/v1
EFFORT_MODE=kwargs
STRONG_THINKING=true
STRONG_EFFORT=medium
DEEP_EFFORT=xhigh
FAST_MODEL=gemma-4-26b-a4b-it-qat
STRONG_MODEL=flash-next
LENGTH_THRESHOLD=1800
SCORE_THRESHOLD=3
LONG_CHAT_TURNS=0
USE_CLASSIFIER=false
DEEP_SCORE=7
DEEP_MARKER=[effort:xhigh]
STRONG_MAX_TOKENS=8192
DEEP_MAX_TOKENS=24576
FAST_MAX_TOKENS=0
FAST_CTX=32768
FAST_CTX_RESERVE=4096
CHARS_PER_TOKEN=3.0
IMAGE_TOKENS=1100
STRONG_HAS_VISION=true
