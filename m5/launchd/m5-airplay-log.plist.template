<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.__USER__.m5-airplay-log</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>__HOME__/bin/m5-airplay-log.sh</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>StartInterval</key><integer>60</integer>
  <key>StandardOutPath</key><string>__HOME__/Library/Logs/m5-airplay-log.err</string>
  <key>StandardErrorPath</key><string>__HOME__/Library/Logs/m5-airplay-log.err</string>
</dict>
</plist>
