<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- LaunchDaemon: root is required for the iogpu sysctl write. No UserName key. -->
  <!-- Label is the literal com.user.m5-wired-limit. install.sh does NOT render files under system/. -->
  <key>Label</key><string>com.user.m5-wired-limit</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/sbin/sysctl</string>
    <string>iogpu.wired_limit_mb=__WIRED_LIMIT_MB__</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
  <key>ThrottleInterval</key><integer>30</integer>
  <key>StandardOutPath</key><string>/var/log/m5-wired-limit.log</string>
  <key>StandardErrorPath</key><string>/var/log/m5-wired-limit.log</string>
</dict>
</plist>
